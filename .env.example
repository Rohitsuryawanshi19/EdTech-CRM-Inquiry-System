# ==============================================================================
# K12 Hunar - EdTech CRM & Inquiry System
# Root Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (.env in /backend or root)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection String
# Find this in Supabase Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (port 6543): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Alternatively, configure discrete connection parameters:
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=postgres
DB_SSL=true

# Custom JWT Authentication Configuration (Supabase Auth is NOT used)
JWT_SECRET=k12_hunar_custom_jwt_secret_key_production_grade_random_hash_987654321
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (Comma-separated for multiple domains)
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials (used by `npm run seed`)
DEFAULT_ADMIN_NAME="K12 Hunar SuperAdmin"
DEFAULT_ADMIN_EMAIL=admin@k12hunar.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (.env in /frontend)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
